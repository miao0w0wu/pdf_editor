/** Word 转 PDF 对话框：单选 docx → 输出目录 → soffice 后台转换。
 *
 * soffice 无细粒度进度，仅展示阶段状态（spec 5.7）；子进程转换无法
 * 中途取消，不提供取消按钮。需要本机安装 LibreOffice。
 */
import { useEffect, useState } from "react";
import { App, Alert, Button, Modal, Space, Spin, Typography } from "antd";
import { FolderOpenOutlined, FileWordOutlined } from "@ant-design/icons";
import { invoke } from "../../api/client";
import { errorMessage, openPdfAtPath } from "../../api/commands";
import { useDocumentStore } from "../../store/document";

/** 取路径的目录部分（兼容 / 与 \）。 */
function dirname(path: string): string {
  const i = Math.max(path.lastIndexOf("/"), path.lastIndexOf("\\"));
  return i > 0 ? path.slice(0, i) : path;
}

export function WordToPdfDialog({ open, onClose }: { open: boolean; onClose: () => void }) {
  const { message } = App.useApp();
  const tasks = useDocumentStore((s) => s.tasks);

  const [docxPath, setDocxPath] = useState<string | null>(null);
  const [outDir, setOutDir] = useState<string | null>(null);
  const [taskId, setTaskId] = useState<string | null>(null);
  const [resultPath, setResultPath] = useState<string | null>(null);

  const task = taskId ? tasks[taskId] : undefined;
  const running = task?.status === "running";

  useEffect(() => {
    if (!open) {
      setDocxPath(null);
      setOutDir(null);
      setTaskId(null);
      setResultPath(null);
    }
  }, [open]);

  useEffect(() => {
    if (!taskId || !task) return;
    if (task.status === "done") setResultPath(task.result ?? null);
    if (task.status === "error") setTaskId(null);
  }, [taskId, task]);

  const pickDocx = async () => {
    try {
      const picked = await invoke<string | null>("dialog.pick_docx_file");
      if (picked) {
        setDocxPath(picked);
        setOutDir(dirname(picked)); // 默认输出到源文件所在目录
      }
    } catch (e) {
      void message.error(`选择文档失败：${errorMessage(e)}`);
    }
  };

  const pickOutDir = async () => {
    try {
      const picked = await invoke<string | null>("dialog.pick_output_directory");
      if (picked) setOutDir(picked);
    } catch (e) {
      void message.error(`选择输出目录失败：${errorMessage(e)}`);
    }
  };

  const start = async () => {
    if (!docxPath || !outDir) return;
    try {
      const handle = await invoke<{ task_id: string }>(
        "converter.convert_word_to_pdf",
        docxPath,
        outDir,
        120,
      );
      setTaskId(handle.task_id);
    } catch (e) {
      void message.error(`启动转换失败：${errorMessage(e)}`);
    }
  };

  return (
    <Modal
      title="Word 转 PDF"
      open={open}
      onCancel={onClose}
      maskClosable={false}
      width={620}
      footer={
        resultPath ? [
          <Button
            key="open"
            type="primary"
            onClick={() => {
              void openPdfAtPath(resultPath).catch((e) =>
                message.error(`打开失败：${errorMessage(e)}`),
              );
              onClose();
            }}
          >
            打开生成的 PDF
          </Button>,
          <Button key="close" onClick={onClose}>
            完成
          </Button>,
        ] : running ? [
          <Button key="close" disabled onClick={onClose}>
            转换中…
          </Button>,
        ] : [
          <Button key="close" onClick={onClose}>
            关闭
          </Button>,
          <Button
            key="start"
            type="primary"
            disabled={!docxPath || !outDir}
            onClick={() => void start()}
          >
            开始转换
          </Button>,
        ]
      }
    >
      {resultPath ? (
        <Space direction="vertical" size="middle" style={{ width: "100%" }}>
          <Typography.Text>转换完成，文件已保存到：</Typography.Text>
          <Typography.Text copyable code>
            {resultPath}
          </Typography.Text>
        </Space>
      ) : running ? (
        <Space direction="vertical" size="middle" style={{ width: "100%" }}>
          <Space>
            <Spin />
            <Typography.Text>{task?.stage ?? "正在启动 LibreOffice…"}</Typography.Text>
          </Space>
          <Typography.Text type="secondary">
            由 LibreOffice 子进程执行，耗时取决于文档大小；转换过程无法中断。
          </Typography.Text>
        </Space>
      ) : (
        <Space direction="vertical" size="middle" style={{ width: "100%" }}>
          <Alert
            type="info"
            showIcon
            message="需要本机安装 LibreOffice（soffice）；未安装时会提示 SofficeNotFoundError 与安装建议。"
          />
          <Button icon={<FileWordOutlined />} onClick={() => void pickDocx()}>
            {docxPath ? "更改 Word 文档" : "选择 Word 文档（.docx）"}
          </Button>
          {docxPath && (
            <Typography.Text code ellipsis style={{ maxWidth: 560 }} title={docxPath}>
              {docxPath}
            </Typography.Text>
          )}
          <Space wrap>
            <Button icon={<FolderOpenOutlined />} disabled={!docxPath} onClick={() => void pickOutDir()}>
              更改输出目录
            </Button>
            {outDir && (
              <Typography.Text code ellipsis style={{ maxWidth: 420 }} title={outDir}>
                {outDir}
              </Typography.Text>
            )}
          </Space>
        </Space>
      )}
    </Modal>
  );
}
